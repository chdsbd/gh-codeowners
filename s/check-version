#!/usr/bin/env bash
# s/check-version
#
# Errors if the latest version in CHANGELOG.md doesn't match Cargo.toml.
set -euo pipefail

cd "$(dirname "$0")/.."

changelog_version=$(sed -nE 's/^## v?([0-9]+\.[0-9]+\.[0-9]+) .*[0-9]{4}-[0-9]{2}-[0-9]{2}.*/\1/p' CHANGELOG.md | head -n 1)
cargo_version=$(sed -nE 's/^version = "([0-9]+\.[0-9]+\.[0-9]+)"$/\1/p' Cargo.toml | head -n 1)

echo "changelog_version: $changelog_version"
echo "cargo_version: $cargo_version"

if [[ -z "$changelog_version" || "$changelog_version" != "$cargo_version" ]]; then
  echo "❌ version mismatch"
  exit 1
fi
echo "✅ versions match"
